# Neon Postgres connection string (https://neon.tech — create a project, copy the pooled connection string)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# better-auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-32+-char-random-string"
BETTER_AUTH_URL="http://localhost:3001"

# Gmail (via Nodemailer) — sends the signup email-verification link.
# Turn on 2-Step Verification on the Google account, then create an App Password
# (Google Account → Security → App passwords) and paste the 16-char value below.
# GMAIL_USER is the sending address; it also appears as the "from".
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
GMAIL_SENDER_NAME="Våre oppskrifter"
